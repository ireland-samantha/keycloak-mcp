{
  "name": "keycloak-mcp",
  "version": "0.1.1",
  "description": "Keycloak Admin REST MCP server and OpenClaw extension with compensating workflows",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ireland-samantha/keycloak-mcp.git" },
  "files": ["src", "data", "openclaw", "openclaw.plugin.json", "README.md", "SECURITY.md", "LICENSE", "NOTICE.md"],
  "bin": {
    "keycloak-mcp": "./src/index.js"
  },
  "exports": {
    ".": "./src/api.js",
    "./openclaw": "./openclaw/index.js"
  },
  "openclaw": { "extensions": ["./openclaw/index.js"] },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/mock/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:mock": "node --test \"test/mock/**/*.test.js\"",
    "live:soak": "node scripts/live-soak.mjs",
    "live:coverage": "node scripts/live-coverage.mjs",
    "live:openclaw": "node scripts/live-openclaw.mjs",
    "check": "node scripts/check-syntax.mjs && npm test",
    "catalog:update": "node scripts/update-catalog.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "pg": "8.16.3",
    "zod": "4.6.5"
  }
}
